---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import SiteLayout from '@/layouts/SiteLayout.astro';
import SubscribeCard from '@/components/SubscribeCard.astro';
import { site } from '@/data/site';

interface Props {
  post: CollectionEntry<'blog'>;
  previous?: CollectionEntry<'blog'>;
  next?: CollectionEntry<'blog'>;
}

const { post, previous, next } = Astro.props;
const { Content } = await render(post);

const stamp = (date: Date) =>
  `${date.getFullYear()}.${String(date.getMonth() + 1).padStart(2, '0')}.${String(date.getDate()).padStart(2, '0')}`;
// 中文按每分钟约 320 字estimate，至少显示 1 分钟
const minutes = Math.max(1, Math.round((post.body ?? '').replace(/\s/g, '').length / 320));
---

<SiteLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.cover || undefined}
  type="article"
  date={post.data.date}
  author={site.author}
  section={post.data.category}
  tags={post.data.tags}
>
  <article class="container-page pb-20 pt-9 md:pt-12">
    <div class="mx-auto max-w-[720px]">
      {/* 默认回归档；有同源来路时改为回到进入这篇文章的那一页 */}
      <a
        class="font-mono text-[12.5px] tracking-[0.08em] text-faint hover:text-accent"
        href="/archive"
        data-back-link
      >← 返回归档</a>
    </div>

    <header class="mx-auto max-w-[720px] text-center">
      <p class="mt-11 font-mono text-[12px] tracking-[0.14em] text-faint">
        {stamp(post.data.date)} · {post.data.category}{post.data.city ? ` · ${post.data.city}` : ''} · 约 {minutes} 分钟
      </p>
      <h1 class="mt-6 font-serif text-[2.5rem] leading-[1.3] text-ink text-balance md:text-[3.2rem]">
        {post.data.title}
      </h1>
      <p class="mx-auto mt-6 max-w-[30em] text-[1.1rem] leading-[2] text-prose text-pretty">{post.data.description}</p>
      <div class="mx-auto mt-8 h-px w-16 bg-accent/45"></div>
    </header>

    <figure class="mx-auto mt-11 max-w-[720px]">
      {post.data.cover ? (
        <img class="aspect-[16/10] w-full rounded-[4px] object-cover" src={post.data.cover} alt={post.data.title} />
      ) : (
        <div class="film-frame flex aspect-[16/10] items-end rounded-[4px] p-6">
          <div class="film-skyline"></div>
          <span class="relative font-serif text-2xl text-white drop-shadow">{site.name}</span>
        </div>
      )}
      <figcaption class="mt-3 text-center font-mono text-[11.5px] tracking-[0.06em] text-faint">
        {post.data.city ? `${post.data.city} · ` : ''}{stamp(post.data.date)}
      </figcaption>
    </figure>

    <div class="mx-auto max-w-[720px]">
      {/* 首段稍大，给短文一个开场 */}
      <div class="prose-warm mt-12 [&>p:first-child]:text-[1.18rem] [&>p:first-child]:leading-[2]">
        <Content />
      </div>

      <div class="mt-14 flex flex-col items-center gap-5 border-t border-line pt-9">
        <div class="seal-mark p-[10px_7px_6px] text-[17px] tracking-[0.24em]">{site.author}</div>
        {post.data.tags.length > 0 && (
          <div class="flex flex-wrap justify-center gap-x-4 gap-y-1.5">
            {post.data.tags.map((tag) => (
              <a
                class="font-mono text-[12.5px] tracking-[0.06em] text-faint hover:text-accent"
                href={`/archive?tag=${encodeURIComponent(tag)}`}
              >#{tag}</a>
            ))}
          </div>
        )}
      </div>

      {(previous || next) && (
        <nav class="mt-12 flex flex-col gap-6 border-t border-line pt-7 sm:flex-row sm:items-start sm:justify-between">
          {previous ? (
            <a class="group block sm:max-w-[46%]" href={`/posts/${previous.id}`}>
              <span class="font-mono text-[11.5px] tracking-[0.08em] text-faint">上一篇</span>
              <span class="mt-1.5 block text-[17px] leading-[1.7] text-ink transition group-hover:text-accent">
                {previous.data.title}
              </span>
            </a>
          ) : (
            <span aria-hidden="true"></span>
          )}
          {next && (
            <a class="group block sm:max-w-[46%] sm:text-right" href={`/posts/${next.id}`}>
              <span class="font-mono text-[11.5px] tracking-[0.08em] text-faint">下一篇</span>
              <span class="mt-1.5 block text-[17px] leading-[1.7] text-ink transition group-hover:text-accent">
                {next.data.title}
              </span>
            </a>
          )}
        </nav>
      )}

      <div class="mt-12"><SubscribeCard compact /></div>
    </div>
  </article>

  <script>
    // 返回链接跟随来路：从首页/扫街/城市地图点进来，就回到那一页，
    // 而不是一律回归档。直接打开或站外进来时保持默认的 /archive。
    const link = document.querySelector<HTMLAnchorElement>('[data-back-link]');
    const labels: Record<string, string> = {
      '/': '首页',
      '/archive': '归档',
      '/street': '扫街周记',
      '/cities': '城市地图',
      '/timeline': '成长时间线',
      '/about': '关于'
    };

    if (link && document.referrer) {
      try {
        const from = new URL(document.referrer);
        const path = from.pathname.replace(/\/$/, '') || '/';
        const label = labels[path] ?? (path.startsWith('/posts/') ? '上一页' : '');
        if (from.origin === location.origin && label && from.pathname !== location.pathname) {
          link.textContent = `← 返回${label}`;
          // 保留 href，中键和右键新标签页才有意义
          link.href = from.pathname + from.search + from.hash;
          link.addEventListener('click', (event) => {
            // 走 history.back() 才能保住归档页的筛选状态和滚动位置；
            // 新标签页打开时 history 只有一条，交给 href 正常跳转
            if (event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;
            if (history.length > 1) {
              event.preventDefault();
              history.back();
            }
          });
        }
      } catch {
        /* referrer 不是合法 URL 时保持默认 */
      }
    }
  </script>
  <script>
    (function () {
      // 非微信环境（PC、其它浏览器等）直接跳过：不加载 jweixin SDK，也不请求签名接口。
      if (!/MicroMessenger/i.test(navigator.userAgent)) return;

      const url = location.href.split('#')[0];
      const reportError = (errMsg: string) => {
        // fire-and-forget；sendBeacon 不阻塞 unload，签名失败也算运维信号
        const payload = JSON.stringify({ url, errMsg });
        if (navigator.sendBeacon) {
          navigator.sendBeacon('/wechat/callback/jsapi-signature/error', new Blob([payload], { type: 'application/json' }));
        } else {
          fetch('/wechat/callback/jsapi-signature/error', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: payload,
            keepalive: true
          }).catch(() => {});
        }
      };
      // 动态注入 JS-SDK，避免非微信环境也下载它。
      const sdk = document.createElement('script');
      sdk.src = 'https://res.wx.qq.com/open/js/jweixin-1.6.0.js';
      sdk.onload = () => {
        const wx = (window as any).wx;
        if (!wx) { reportError('wx sdk missing after load'); return; }
        fetch(`/wechat/callback/jsapi-signature?url=${encodeURIComponent(url)}`)
          .then((res) => {
            if (!res.ok) throw new Error(`HTTP ${res.status}`);
            return res.json();
          })
          .then((data: any) => {
            wx.config({
              debug: false,
              appId: data.appId,
              timestamp: data.timestamp,
              nonceStr: data.nonceStr,
              signature: data.signature,
              jsApiList: ['getNetworkType']
            });
            wx.error((res: any) => reportError(res?.errMsg ?? 'unknown wx.error'));
            wx.ready(() => {
              // 订阅号没有分享接口权限，用 getNetworkType 验证 JS-SDK 能否工作。
              // 成功时 console.log 网络类型；失败时上报到后端 jsapi_signature_error 表。
              wx.getNetworkType({
                success: (res: any) => {
                  console.log('[wechat-jsapi] getNetworkType ok:', res.networkType);
                },
                fail: (err: any) => {
                  console.warn('[wechat-jsapi] getNetworkType failed:', err?.errMsg);
                  reportError(`getNetworkType: ${err?.errMsg ?? 'unknown'}`);
                }
              });
            });
          })
          .catch((err: any) => reportError(`fetch failed: ${err?.message ?? err}`));
      };
      sdk.onerror = () => reportError('jweixin load failed');
      document.head.appendChild(sdk);
    })();
  </script>
</SiteLayout>
