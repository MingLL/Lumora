---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const ym = (date: Date) => `${date.getFullYear()}.${String(date.getMonth() + 1).padStart(2, '0')}`;
---

<section id="now" class="container-page mt-16 scroll-mt-24">
  <div class="mb-16 flex items-center gap-[18px]">
    <span class="section-kicker">01 / 从这里开始</span>
    <span class="h-px flex-1 bg-line"></span>
  </div>

  <article class="mx-auto max-w-[760px] border border-line-soft bg-card p-9 md:p-[clamp(36px,6vw,76px)]">
    <div class="font-mono text-xs tracking-[0.16em] text-faint">第一篇 · {ym(post.data.date)}</div>
    <h2 class="mt-6 text-[clamp(25px,3.4vw,36px)] font-semibold leading-[1.5] tracking-[0.03em] text-pretty">
      {post.data.title}
    </h2>
    <div class="my-9 h-0.5 w-11 bg-accent"></div>
    <p class="text-[18px] leading-[2.1] text-[#3A352E] text-pretty">「{post.data.description}」</p>
    <p class="mt-6 text-[15.5px] leading-[2.1] text-muted text-pretty">
      这是「远方有温度」的第一篇文章。如果你是第一次来，不妨就从这里读起，顺着时间往下走。
    </p>
    <a class="mt-11 inline-block border-b border-accent pb-[3px] text-base text-accent hover:opacity-70" href={`/posts/${post.id}`}>从头读起 →</a>
  </article>
</section>
