---
import { site } from '@/data/site';
---

<footer class="mt-24 border-t border-line md:mt-[100px]">
  <div class="container-page flex flex-wrap items-center justify-between gap-x-10 gap-y-4 pb-5 pt-9 font-mono text-xs text-faint">
    <span>{site.name} · 2021 — 2026 · {site.author}</span>
    <span class="flex gap-[26px]">
      <a class="hover:text-accent" href="/about">公众号</a>
      <a class="hover:text-accent" href={`mailto:${site.email}`}>邮箱</a>
      <a class="hover:text-accent" href="/rss.xml">RSS</a>
    </span>
  </div>
  <div class="container-page flex flex-wrap items-center justify-between gap-x-6 gap-y-3 pb-9 font-mono text-[11px] tracking-[0.08em] text-faint">
    <span>Copyright Lumora™</span>
    <span class="flex flex-wrap items-center justify-end gap-x-5 gap-y-3">
      <a class="hover:text-accent" href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer">宁ICP备2026002762号-1</a>
      <a
        class="inline-flex items-center gap-1.5 hover:text-accent"
        href="https://beian.mps.gov.cn/#/query/webSearch?code=64050202000274"
        target="_blank"
        rel="noopener noreferrer"
      >
        <img
          class="h-4 w-4"
          src="/images/mps-beian.png"
          alt="公安备案图标"
          width="20"
          height="20"
        />
        宁公网安备64050202000274号
      </a>
    </span>
  </div>
</footer>
