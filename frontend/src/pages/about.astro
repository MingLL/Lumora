---
import SiteLayout from '@/layouts/SiteLayout.astro';
import SubscribeCard from '@/components/SubscribeCard.astro';
import { heroCopy, site } from '@/data/site';
import { coverPlaceholder } from '@/lib/image-meta.mjs';

const portraitStyle = await coverPlaceholder('/images/covers/twenty-eight.jpg');

const notes = [
  {
    title: '为什么写作',
    body: '有次面试，面试官问我这些年受过最大的挫折是什么。我沉默了一两分钟，脑子里像过电影一样想了一遍，却没有一件能说出口的。那时候我想，我该记录点什么了。'
  },
  {
    title: '适合谁阅读',
    body: '如果你也在毕业、上班、换城市、做选择这些事里打转，这里的文字可能和你有几分像。'
  }
];
---

<SiteLayout title="关于我" description="关于温野和公众号远方有温度。">
  <section class="container-page py-12 md:py-16">
    <div class="grid gap-x-16 gap-y-10 md:grid-cols-[0.85fr_1.15fr] md:items-start">
      <div class="md:sticky md:top-28">
        <p class="section-kicker">About</p>
        <h1 class="mt-4 font-serif text-4xl text-ink md:text-6xl">关于我</h1>
        <figure class="relative mt-8 overflow-hidden rounded-[6px] shadow-soft">
          <img
            class="aspect-[4/3] w-full object-cover"
            src="/images/covers/twenty-eight.jpg"
            alt="黄昏里走在路上的人"
            decoding="async"
            style={portraitStyle}
          />
          <div class="pointer-events-none absolute inset-x-0 bottom-0 h-3/5 bg-gradient-to-t from-[rgba(28,25,22,0.78)] to-transparent"></div>
          <figcaption class="absolute inset-x-0 bottom-0 p-6">
            <p class="font-serif text-[1.45rem] leading-snug text-balance text-white">你要拥有奔向远方的勇气，感受温度的热情。</p>
          </figcaption>
        </figure>
        <div class="mt-9 flex items-end justify-between gap-6">
          <p class="hand-note text-[1.7rem] leading-[1.7]">{heroCopy.note[0]}<br />{heroCopy.note[1]}</p>
          <div class="seal-mark p-[11px_8px_7px] text-[19px] tracking-[0.24em]">{site.author}</div>
        </div>
      </div>

      {/* 开场白用正文体，两段随笔降为分隔行，只有订阅是卡片——
          原来五个同重量的卡片叠在一起，读不出主次 */}
      <div>
        <h2 class="font-serif text-[2rem] leading-snug text-ink md:text-[2.4rem]">你好，我是温野。</h2>
        <div class="mt-6 space-y-5 text-[1.05rem] leading-[2] text-prose text-pretty">
          <p>一个自认「不凡」，却过着平凡生活的普通人。2021 年从福州毕业去了北京，做了三年互联网，2024 年决定回家。</p>
          <p>公众号叫「远方有温度」，从 2021 年写到现在。写工作、写生活、写走过的城市，也写几次不太容易的决定。我读的书不多，文字也算不上华丽，但写下的都是真的。</p>
        </div>

        <div class="mt-12 border-t border-line">
          {notes.map((note) => (
            <div class="border-b border-line py-7">
              <h3 class="font-serif text-xl text-ink">{note.title}</h3>
              <p class="mt-3 leading-[2] text-muted text-pretty">{note.body}</p>
            </div>
          ))}
        </div>

        <div class="mt-12">
          <SubscribeCard />
        </div>

        <div class="mt-10 flex flex-wrap items-baseline gap-x-4 gap-y-2">
          <span class="section-kicker">联系我</span>
          <a class="text-ink underline decoration-line underline-offset-[6px] transition hover:text-accent hover:decoration-accent" href={`mailto:${site.email}`}>
            {site.email}
          </a>
          <span class="text-sm text-muted">也可以在公众号里给我留言。</span>
        </div>
      </div>
    </div>
  </section>
</SiteLayout>
