---
import { getCollection } from 'astro:content';
import SiteLayout from '@/layouts/SiteLayout.astro';
import StreetPhotoGrid from '@/components/StreetPhotoGrid.astro';

const posts = (await getCollection('blog'))
  .filter((post) => post.data.series === '扫街周记' || post.data.category === '扫街周记')
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<SiteLayout title="扫街周记" description="带着相机在城市里走，一周一辑。">
  <section class="container-page py-12 md:py-16">
    <div class="max-w-3xl">
      <p class="text-sm text-accent">STREET WEEKLY</p>
      <h1 class="mt-3 font-serif text-4xl text-ink md:text-6xl">扫街周记</h1>
      <p class="mt-5 text-lg leading-8 text-muted">带着相机在城市里走，一周一辑。拍得一般，但都是自己走过的路。</p>
    </div>
    <div class="mt-10">
      <StreetPhotoGrid posts={posts} />
    </div>
  </section>
</SiteLayout>
