---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import SiteLayout from '@/layouts/SiteLayout.astro';
import SubscribeCard from '@/components/SubscribeCard.astro';
import { site } from '@/data/site';

interface Props {
  post: CollectionEntry<'blog'>;
  previous?: CollectionEntry<'blog'>;
  next?: CollectionEntry<'blog'>;
}

const { post, previous, next } = Astro.props;
const { Content } = await render(post);

const stamp = (date: Date) =>
  `${date.getFullYear()}.${String(date.getMonth() + 1).padStart(2, '0')}.${String(date.getDate()).padStart(2, '0')}`;
// 中文按每分钟约 320 字estimate，至少显示 1 分钟
const minutes = Math.max(1, Math.round((post.body ?? '').replace(/\s/g, '').length / 320));
---

<SiteLayout title={post.data.title} description={post.data.description} image={post.data.cover || undefined}>
  <article class="container-page pb-20 pt-9 md:pt-12">
    <div class="mx-auto max-w-[720px]">
      <a class="font-mono text-[12.5px] tracking-[0.08em] text-faint hover:text-accent" href="/archive">← 返回归档</a>
    </div>

    <header class="mx-auto max-w-[720px] text-center">
      <p class="mt-11 font-mono text-[12px] tracking-[0.14em] text-faint">
        {stamp(post.data.date)} · {post.data.category}{post.data.city ? ` · ${post.data.city}` : ''} · 约 {minutes} 分钟
      </p>
      <h1 class="mt-6 font-serif text-[2.5rem] leading-[1.3] text-ink text-balance md:text-[3.2rem]">
        {post.data.title}
      </h1>
      <p class="mx-auto mt-6 max-w-[30em] text-[1.1rem] leading-[2] text-prose text-pretty">{post.data.description}</p>
      <div class="mx-auto mt-8 h-px w-16 bg-accent/45"></div>
    </header>

    <figure class="mx-auto mt-11 max-w-[720px]">
      {post.data.cover ? (
        <img class="aspect-[16/10] w-full rounded-[4px] object-cover" src={post.data.cover} alt={post.data.title} />
      ) : (
        <div class="film-frame flex aspect-[16/10] items-end rounded-[4px] p-6">
          <div class="film-skyline"></div>
          <span class="relative font-serif text-2xl text-white drop-shadow">{site.name}</span>
        </div>
      )}
      <figcaption class="mt-3 text-center font-mono text-[11.5px] tracking-[0.06em] text-faint">
        {post.data.city ? `${post.data.city} · ` : ''}{stamp(post.data.date)}
      </figcaption>
    </figure>

    <div class="mx-auto max-w-[720px]">
      {/* 首段稍大，给短文一个开场 */}
      <div class="prose-warm mt-12 [&>p:first-child]:text-[1.18rem] [&>p:first-child]:leading-[2]">
        <Content />
      </div>

      <div class="mt-14 flex flex-col items-center gap-5 border-t border-line pt-9">
        <div class="seal-mark p-[10px_7px_6px] text-[17px] tracking-[0.24em]">{site.author}</div>
        {post.data.tags.length > 0 && (
          <div class="flex flex-wrap justify-center gap-x-4 gap-y-1.5">
            {post.data.tags.map((tag) => (
              <a
                class="font-mono text-[12.5px] tracking-[0.06em] text-faint hover:text-accent"
                href={`/archive?tag=${encodeURIComponent(tag)}`}
              >#{tag}</a>
            ))}
          </div>
        )}
      </div>

      {(previous || next) && (
        <nav class="mt-12 flex flex-col gap-6 border-t border-line pt-7 sm:flex-row sm:items-start sm:justify-between">
          {previous ? (
            <a class="group block sm:max-w-[46%]" href={`/posts/${previous.id}`}>
              <span class="font-mono text-[11.5px] tracking-[0.08em] text-faint">上一篇</span>
              <span class="mt-1.5 block text-[17px] leading-[1.7] text-ink transition group-hover:text-accent">
                {previous.data.title}
              </span>
            </a>
          ) : (
            <span aria-hidden="true"></span>
          )}
          {next && (
            <a class="group block sm:max-w-[46%] sm:text-right" href={`/posts/${next.id}`}>
              <span class="font-mono text-[11.5px] tracking-[0.08em] text-faint">下一篇</span>
              <span class="mt-1.5 block text-[17px] leading-[1.7] text-ink transition group-hover:text-accent">
                {next.data.title}
              </span>
            </a>
          )}
        </nav>
      )}

      <div class="mt-12"><SubscribeCard compact /></div>
    </div>
  </article>
</SiteLayout>
