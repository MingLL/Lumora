---
import type { CollectionEntry } from 'astro:content';
import PostCard from '@/components/PostCard.astro';

interface Props {
  posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
---

<section class="container-page py-16 md:py-20">
  <div class="mb-9 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
    <div>
      <p class="section-kicker">Featured Stories</p>
      <h2 class="mt-3 font-serif text-3xl leading-tight text-ink md:text-5xl">从一个阶段，走向另一个阶段</h2>
    </div>
    <a class="text-sm text-muted hover:text-accent" href="/archive">查看全部文章 →</a>
  </div>
  <div class="grid gap-6 md:grid-cols-3">
    {posts.map((post) => <PostCard post={post} />)}
  </div>
</section>
