---
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;

// 按时间倒序，并识别最早的一篇（第一篇）
const sorted = [...posts].sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const firstEverId = sorted.length ? sorted[sorted.length - 1].id : '';

// 每年最多列 5 篇，其余走「该年共 N 篇」进归档，
// 否则一年二十几篇扫街周记会把首页拉到一万像素以上
const MAX_PER_YEAR = 5;

const years = [...new Set(sorted.map((post) => post.data.date.getFullYear()))].sort((a, b) => b - a);
const groups = years.map((year) => {
  const all = sorted.filter((post) => post.data.date.getFullYear() === year);
  return { year, entries: all.slice(0, MAX_PER_YEAR), total: all.length };
});

const ym = (date: Date) => `${date.getFullYear()}.${String(date.getMonth() + 1).padStart(2, '0')}`;
---

<section id="toc" class="container-page mt-[130px] scroll-mt-24">
  <div class="mb-[26px] flex items-center gap-[18px]">
    <span class="section-kicker">03 / 时间线</span>
    <span class="h-px flex-1 bg-line"></span>
  </div>
  <p class="mb-14 max-w-[36em] text-base leading-[2] text-muted text-pretty">从第一篇写到现在，一年一年往下走。</p>

  {groups.map((group) => (
    <div class="mt-9 grid grid-cols-[minmax(72px,110px)_1fr] gap-x-7 first:mt-0">
      <div class="pt-3.5 text-[26px] font-semibold text-ink">{group.year}</div>
      <div>
        {group.entries.map((post) => {
          const isFirst = post.id === firstEverId;
          return (
            <a
              class="group relative block border-l border-line py-4 pl-[30px] pr-2 transition hover:bg-[#F2ECDD]"
              href={`/posts/${post.id}`}
            >
              <span
                class:list={[
                  'absolute left-[-3.5px] top-6 h-1.5 w-1.5 rounded-full',
                  isFirst ? 'bg-accent' : 'bg-[#B8AD94]'
                ]}
              ></span>
              <span class="font-mono text-[11.5px] tracking-[0.06em] text-faint">
                {ym(post.data.date)}{isFirst ? ' · 第一篇' : ''}
              </span>
              <span class="mt-[7px] block text-[19px] font-semibold leading-[1.7] tracking-[0.02em] text-pretty group-hover:text-accent">
                {post.data.title}
              </span>
              <span class="mt-1.5 block text-[13.5px] leading-[1.9] text-muted text-pretty">{post.data.description}</span>
            </a>
          );
        })}
        {group.total > group.entries.length && (
          <a
            class="block border-l border-line py-4 pl-[30px] font-mono text-[12px] tracking-[0.06em] text-faint hover:text-accent"
            href={`/archive#y${group.year}`}
          >{group.year} 年共 {group.total} 篇 →</a>
        )}
      </div>
    </div>
  ))}
</section>
