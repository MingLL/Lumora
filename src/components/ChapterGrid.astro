---
import type { CollectionEntry } from 'astro:content';
import { chapterOrder, chapterNumerals } from '@/data/site';

interface Props {
  posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;

const chapters = chapterOrder
  .map((category) => ({
    category,
    entries: posts
      .filter((post) => post.data.category === category)
      .sort((a, b) => a.data.date.getTime() - b.data.date.getTime())
  }))
  .filter((chapter) => chapter.entries.length > 0);
---

<section id="chapters" class="container-page mt-[130px] scroll-mt-24">
  <div class="mb-[26px] flex items-center gap-[18px]">
    <span class="section-kicker">02 / 章节入口</span>
    <span class="h-px flex-1 bg-line"></span>
  </div>
  <p class="mb-14 max-w-[36em] text-base leading-[2] text-muted text-pretty">
    这些年被分成几个章节。不是栏目，是一段一段真实走过的路。
  </p>

  {/* 外框负责闭合矩形，格线画在单元格上；负边距 + overflow-hidden 裁掉
      最右列和最后一行重复的 1px，这样章节数量凑不满整行时右下角也不会缺口。 */}
  <div class="overflow-hidden border border-line">
    <div class="-mb-px -mr-px grid grid-cols-[repeat(auto-fit,minmax(300px,1fr))]">
      {chapters.map((chapter, index) => (
        <div class="flex flex-col gap-3 border-b border-r border-line px-7 pb-9 pt-[34px]">
          <span class="text-4xl font-black text-accent/90">{chapterNumerals[index]}</span>
          <span class="text-[21px] font-semibold tracking-[0.04em]">{chapter.category}</span>
          <span class="flex flex-col gap-2 text-[13.5px] leading-[1.8] text-muted">
            {chapter.entries.map((post) => (
              <a class="text-muted hover:text-accent" href={`/posts/${post.id}`}>· {post.data.title}</a>
            ))}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>
