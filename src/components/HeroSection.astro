---
import { heroCopy, site } from '@/data/site';

interface Props {
  photo?: string;
  caption?: string;
}

const { photo = '', caption = '扫街周记 · 用镜头记录街头' } = Astro.props;
---

<section
  id="top"
  class="container-page flex flex-wrap-reverse items-stretch gap-x-16 gap-y-10 pt-8 md:min-h-[80vh] md:pt-14"
>
  <div class="flex min-w-0 flex-1 basis-[460px] flex-col">
    <p class="font-mono text-xs tracking-[0.24em] text-faint">{heroCopy.eyebrow}</p>

    <h2 class="mt-10 max-w-[16em] text-[clamp(25px,3.2vw,34px)] font-semibold leading-[1.85] tracking-[0.03em] text-pretty">
      {heroCopy.headline[0]}<br />{heroCopy.headline[1]}
    </h2>

    <p class="mt-6 max-w-[31em] text-[16.5px] leading-[2.1] text-prose text-pretty">{heroCopy.intro}</p>

    <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4">
      <a
        class="inline-block border border-accent px-8 py-3 text-[15px] tracking-[0.32em] text-accent transition hover:bg-accent hover:text-paper"
        href="#now"
      >开始阅读</a>
      <a class="font-mono text-[13px] tracking-[0.06em] text-muted hover:text-accent" href="#toc">翻开时间线 →</a>
      <a class="font-mono text-[13px] tracking-[0.06em] text-muted hover:text-accent" href="#street">看扫街周记 →</a>
    </div>

    <div class="relative mt-14 h-[340px] max-w-[500px] md:h-[320px]">
      <div class="absolute left-0 top-1 w-[66%] -rotate-[1.6deg] border border-line-soft bg-white p-[9px_9px_10px] shadow-[0_3px_22px_rgba(43,39,35,0.10)]">
        {photo ? (
          <img class="block h-[205px] w-full object-cover" src={photo} alt={caption} loading="lazy" />
        ) : (
          <div class="photo-slot h-[205px] w-full">一张街头照片</div>
        )}
        <div class="pt-2 font-mono text-[11px] tracking-[0.06em] text-faint">{caption}</div>
      </div>
      <div class="absolute right-0 top-[52%] box-border w-[46%] rotate-[2deg] border border-line-soft bg-note p-[20px_22px_16px] shadow-[0_4px_18px_rgba(43,39,35,0.12)]">
        <div class="font-hand text-[21px] leading-[1.7] text-accent">{heroCopy.note[0]}<br />{heroCopy.note[1]}</div>
        <div class="mt-2.5 font-mono text-[10.5px] tracking-[0.06em] text-faint">—— {site.author} 手记</div>
      </div>
    </div>

    <a class="mt-auto w-fit pb-9 pt-[52px] font-mono text-xs tracking-[0.12em] text-faint hover:text-accent" href="#now">往下，是这些年 ↓</a>
  </div>

  <div class="flex shrink-0 flex-row justify-end gap-[30px]">
    <div class="hero-side">认真生活，认真记录</div>
    <div class="hero-titlewrap">
      <h1 class="hero-title">{site.name}</h1>
      <div class="seal-mark p-[12px_9px_8px] text-[21px] tracking-[0.24em]">{site.author}</div>
    </div>
  </div>
</section>

<div class="flex justify-center pt-8"><span class="h-[72px] w-px bg-[#CFC5AD]"></span></div>
