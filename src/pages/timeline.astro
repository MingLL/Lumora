---
import { getCollection } from 'astro:content';
import SiteLayout from '@/layouts/SiteLayout.astro';
import { timeline } from '@/data/site';

const posts = await getCollection('blog');
---

<SiteLayout title="成长时间线" description="按年份整理远方有温度里的成长、城市和人生选择。">
  <section class="container-page py-12 md:py-16">
    <div class="max-w-3xl">
      <p class="section-kicker">Timeline</p>
      <h1 class="mt-4 font-serif text-4xl text-ink md:text-6xl">成长时间线</h1>
      <p class="mt-5 text-lg leading-8 text-muted">不是为了证明自己走得多快，只是把那些真实发生过的阶段，一段一段放回生活里。</p>
    </div>
    {/* 年份左栏 + 连续主轴 + 节点，和首页 03/时间线 区块保持同一套结构 */}
    <div class="mt-12">
      {timeline.map((item, index) => {
        const related = posts.filter((post) => item.posts.includes(post.data.title));
        const isLast = index === timeline.length - 1;
        return (
          <div class="grid grid-cols-[minmax(56px,88px)_1fr] gap-x-6 md:gap-x-10">
            <div class="pt-7 font-serif text-[26px] leading-none text-ink md:text-[30px]">{item.year}</div>
            <div
              class:list={[
                'relative border-l border-line pl-7 pt-7 md:pl-10',
                isLast ? 'pb-4' : 'pb-14'
              ]}
            >
              <span class="absolute -left-[5.5px] top-[30px] h-[11px] w-[11px] rounded-full bg-accent ring-4 ring-paper"></span>
              <h2 class="font-serif text-2xl leading-snug text-ink md:text-3xl">{item.title}</h2>
              <p class="mt-3.5 max-w-[40em] leading-[2] text-muted text-pretty">{item.description}</p>
              {related.length > 0 && (
                <ul class="mt-7 max-w-[44em] border-t border-line/70">
                  {related.map((post) => (
                    <li class="border-b border-line/70">
                      <a
                        class="group flex flex-wrap items-baseline gap-x-5 gap-y-1 py-3.5 transition"
                        href={`/posts/${post.id}`}
                      >
                        <span class="w-[4.5em] shrink-0 font-mono text-[11.5px] tracking-[0.06em] text-faint">
                          {post.data.category}
                        </span>
                        <span class="text-[17px] leading-[1.7] text-ink transition group-hover:text-accent">
                          {post.data.title}
                        </span>
                        <span class="ml-auto font-mono text-[12px] text-faint transition group-hover:text-accent">→</span>
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </div>
        );
      })}
    </div>
  </section>
</SiteLayout>
