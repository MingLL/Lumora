---
import { getCollection } from 'astro:content';
import SiteLayout from '@/layouts/SiteLayout.astro';
import CityCard from '@/components/CityCard.astro';
import { cities } from '@/data/site';

const posts = await getCollection('blog');
const cityGroups = cities.map((city) => ({
  ...city,
  posts: posts.filter((post) => post.data.city === city.name)
}));

// 还没有文章的城市不占主网格：整卡「文章即将补充」看起来像页面没做完
const written = cityGroups.filter((city) => city.posts.length > 0);
const pending = cityGroups.filter((city) => city.posts.length === 0);
---

<SiteLayout title="城市地图" description="按城市整理远方有温度里的生活、旅行和阶段记忆。">
  <section class="container-page py-12 md:py-16">
    <div class="max-w-3xl">
      <p class="text-sm text-accent">CITY MAP</p>
      <h1 class="mt-3 font-serif text-4xl text-ink md:text-6xl">城市地图</h1>
      <p class="mt-5 text-lg leading-8 text-muted">先不用真实地图 API。把城市当作章节，把每一次抵达、停靠和告别，都放在一个可以慢慢打开的位置。</p>
    </div>
    <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {written.map((city, index) => (
        <CityCard name={city.name} description={city.description} posts={city.posts} index={index} />
      ))}
    </div>

    {pending.length > 0 && (
      <div class="mt-14 border-t border-line pt-9">
        <span class="section-kicker">还没写到的地方</span>
        <ul class="mt-6 flex flex-wrap gap-x-12 gap-y-4">
          {pending.map((city) => (
            <li class="flex items-baseline gap-3.5">
              <span class="font-serif text-[21px] text-ink/75">{city.name}</span>
              <span class="text-sm text-muted">{city.description}</span>
            </li>
          ))}
        </ul>
      </div>
    )}
  </section>
</SiteLayout>
