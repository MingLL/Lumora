# 微信公众号本地联调环境变量。
#
# 用法：
#   1. 去 https://mp.weixin.qq.com/debug/cgi-bin/sandbox 申请「测试号」，
#      拿到 appID 和 appSecret（两个都要填，见下面 WECHAT_APP_SECRET 的说明）。
#   2. 复制本文件为 .env，填 WECHAT_APP_ID 和 WECHAT_APP_SECRET。
#      WECHAT_ORIGINAL_ID 先留空，第 4 步抓：
#        cp .env.dev.example .env
#   3. 起抓原始 ID 的辅助脚本 + 公网隧道（都在仓库根的 scripts/，不在 backend/ 下）：
#        ../scripts/dev-wechat-original-id.py     # 占住 8080
#        ../scripts/dev-wechat-tunnel.sh          # 另开一个终端
#   4. 回测试号后台把 URL 填成 {隧道地址}/wechat/callback/{WECHAT_APP_ID}，
#      Token 填 WECHAT_TOKEN，选**明文模式**（辅助脚本不解密）。提交后扫码关注
#      测试号，subscribe 推送会把 gh_ 开头的原始 ID 打出来，填进下面，Ctrl-C 停脚本。
#   5. 起真正的本地栈（只跑回调用的 web，不跑会发邮件的 worker）。隧道不用重启，
#      8080 换成 web 容器后回调地址继续有效：
#        docker compose --profile migrate up migrate
#        docker compose up -d web
#
# 这是开发联调用，绝不要用于生产。所有 *_ENABLED 在 compose 的 web 服务里
# 已被强制关掉，所以本地实例不会发邮件、不会跑定时任务。

# ---- 微信测试号（测试号后台给出）----
# appID
WECHAT_APP_ID=
# 测试号的原始 ID，形如 gh_xxxxxxx。代码拿它和每条推送的 ToUserName 做全等比较，
# 填错的话所有推送一律 403，且日志不点名是哪个字段 —— 最常踩的坑。
# 测试号后台不显示它（那是正式号「账号详情」的字段），也翻不到应用日志里
# （WechatCallbackExceptionHandler 刻意不记录消息体）。用上面第 3 步的
# dev-wechat-original-id.py 从第一条推送里抓。
WECHAT_ORIGINAL_ID=
# 自己定，和测试号后台「接口配置信息」里填的一致。
WECHAT_TOKEN=devtoken
# 用于安全模式。明文模式用不到，但应用要求非空，且启动时会 Base64 解码成 32 字节
# （WechatProtocolService 无条件构造 WxMpCryptUtil），所以不能瞎填 ——
# 必须是 43 位 Base64 字符。下面这串已验证可用。
WECHAT_AES_KEY=abcdefghijklmnopqrstuvwxyz0123456789ABCDEFG
# 测试号后台的 appSecret。只被 WechatJsapiSignatureService 用来调微信出站接口
# （cgi-bin/token + cgi-bin/ticket）换 JS-SDK 签名，纯回调联调其实不发这些请求 ——
# 但 LumoraProperties 无条件要求它非空，留空就起不来。只调回调的话填任意非空值即可，
# 想真联调 JS-SDK 签名再填测试号的真实值。
WECHAT_APP_SECRET=dev-app-secret

# ---- PostgreSQL（compose 栈内服务名）----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=lumora
POSTGRES_USERNAME=lumora
POSTGRES_PASSWORD=lumora

# ---- 邮件（联调一般不真发；web 服务已关 internal-send）----
# 想测真实发信再填真实 QQ 邮箱授权码。
MAIL_USERNAME=dev@example.com
MAIL_AUTH_CODE=dev-auth-code
MAIL_FROM_NAME=Lumora-Dev
REPORT_RECIPIENTS=dev@example.com
REPORT_ADMIN_KEY=dev-admin-key

# ---- 区域 ----
LUMORA_ZONE=Asia/Shanghai

# ---- 以下被 compose 的 web 服务覆盖为 false，这里仅占位 ----
SCHEDULING_ENABLED=false
REPORT_RECOVERY_ENABLED=false
RETENTION_ENABLED=false
INTERNAL_SEND_ENABLED=false
WORKER_READY_MARKER=/tmp/lumora-worker-ready
